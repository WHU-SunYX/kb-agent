# Optional: point kb-agent at a different YAML configuration file.
# KB_AGENT_CONFIG=/absolute/path/to/config.yaml

# Nested settings can be overridden using KB_AGENT__<SECTION>__<FIELD>.
KB_AGENT__APP__ENVIRONMENT=development
KB_AGENT__KB__DEFAULT_DOMAIN=ai-ssd
KB_AGENT__RAW_STORE__TYPE=local
KB_AGENT__RAW_STORE__LOCAL_ROOT=./data/dev/raw

# S3-compatible raw store (AWS S3, Ceph RGW, SeaweedFS, etc.).
# Install the optional dependency first: pip install -e ".[s3]"
# KB_AGENT__RAW_STORE__TYPE=s3
# KB_AGENT__RAW_STORE__ENDPOINT_URL=http://127.0.0.1:8333
# KB_AGENT__RAW_STORE__BUCKET=kb-raw
# KB_AGENT__RAW_STORE__REGION=us-east-1
# KB_AGENT__RAW_STORE__ACCESS_KEY_ID=replace-me
# KB_AGENT__RAW_STORE__SECRET_ACCESS_KEY=replace-me

# Local BGE embedding backend. Install with: pip install -e ".[embedding]"
# Production/offline example: /models/BAAI/bge-m3
# KB_AGENT__EMBEDDING__MODEL_NAME_OR_PATH=/models/BAAI/bge-m3
# KB_AGENT__EMBEDDING__DEVICES=cuda:0
# KB_AGENT__EMBEDDING__USE_FP16=true
# KB_AGENT__EMBEDDING__BATCH_SIZE=32
# KB_AGENT__EMBEDDING__QUERY_MAX_LENGTH=512
# KB_AGENT__EMBEDDING__PASSAGE_MAX_LENGTH=512

# Presidio PII detector device (cpu, cuda or cuda:N).
# YAML default: security.pii_device=cpu. This takes effect when FastAPI starts.
# KB_AGENT__SECURITY__PII_DEVICE=cpu
# KB_AGENT__SECURITY__PII_DEVICE=cuda:3

# MCP-only model-context budget; no change to FastAPI search or stored data.
# KB_AGENT__MCP__SEARCH_MAX_RESULTS=5
# KB_AGENT__MCP__SEARCH_MAX_CHARS=10000
